# ============================================================
# ZeroPoint Security - Environment Configuration
# Copy this file to .env and customize before running.
# ============================================================

# Greenbone Vulnerability Manager credentials
GVM_USER=admin
GVM_PASSWORD=admin

# App-level secret (used for session tokens; change in production)
APP_SECRET=change-this-to-a-long-random-string

# ============================================================
# AI Remediation (Ollama LLM)
# ============================================================
# Set OLLAMA_ENABLED=false to fall back to rule-based templates only.
OLLAMA_ENABLED=true

# Which Ollama model to use. Smaller = faster but less detailed.
# Recommendations:
#   llama3.2:3b   - ~2 GB, balanced speed and quality (default)
#   phi3:mini     - ~2.3 GB, fast, decent for short answers
#   gemma2:2b     - ~1.6 GB, smallest, fastest
#   qwen2.5:3b    - ~1.9 GB, good instruction-following
#   llama3.1:8b   - ~4.7 GB, higher quality but slower
OLLAMA_MODEL=llama3.2:3b
